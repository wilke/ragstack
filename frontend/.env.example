# Dev API target for the Vite proxy (see vite.config.ts). Defaults to the local
# Python API. The browser talks to the SPA's own origin; Vite proxies /v1 + /health.
VITE_API_TARGET=http://localhost:8000

# --- Frontend (Vite dev server) --------------------------------------------
# Hosts the dev server will answer for (Vite's DNS-rebinding host check).
# Default when unset: ".bv-brc.org,.anl.gov" (the BV-BRC proxy + coconut gateway;
# a leading dot matches subdomains). A comma-separated list replaces the default;
# "true" allows any host (dev only). localhost/127.0.0.1 are always allowed.
# Dev-server only -- static builds are unaffected. Set in frontend/.env (gitignored).
#VITE_ALLOWED_HOSTS=.example.org

# --- Password sign-in on a plaintext page ----------------------------------
# By default the BV-BRC password form is NOT rendered when the page was loaded
# over plain HTTP (browser isSecureContext=false): an on-path attacker can
# rewrite the form before it renders, so posting over TLS is no defence. This
# build-time knob renders the form anyway. The red warning stays either way.
# Accepted values: 1 / true / yes. DEV/DEMO INSTANCES ONLY — anything real
# should be served over HTTPS instead. Set in frontend/.env (gitignored).
#VITE_ALLOW_PASSWORD_OVER_HTTP=true
