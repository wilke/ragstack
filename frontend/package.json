{
  "name": "ragstack-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "RAGStack dashboard & explorer UI (React + Vite + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "openapi-typescript": "^7.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
