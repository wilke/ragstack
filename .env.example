# RAGStack — shared environment template
# Copy to .env and adjust as needed.

# --- API ---
PORT=8080                      # Go default; Python uses 8000
LOG_LEVEL=info                 # debug | info | warn | error

# --- Infrastructure ---
QDRANT_URL=http://localhost:6333
ELASTICSEARCH_URL=http://localhost:9200
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=neo4j
POSTGRES_URL=postgres://ragstack:ragstack@localhost:5432/ragstack
REDIS_URL=redis://localhost:6379

# --- Models (self-hosted) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CROSSENCODER_MODEL=BAAI/bge-reranker-v2-m3
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Sidecars ---
EMBEDDING_SIDECAR_URL=http://localhost:50053
CROSSENCODER_SIDECAR_URL=http://localhost:50052
FAISS_SIDECAR_URL=http://localhost:50051
SIDECAR_DEVICE=cpu             # cpu | cuda (docker-compose sidecars)
# Apptainer crossencoder sidecar only (apptainer/sidecars-up.sh); independent of
# SIDECAR_DEVICE above. Defaults to cuda on the GPU host, falling back to cpu if no
# nvidia-smi is found. CROSSENCODER_GPU pins which card; RERANK_BATCH_SIZE bounds
# peak GPU memory per rerank forward pass.
CROSSENCODER_DEVICE=cuda       # cuda | cpu
CROSSENCODER_GPU=0             # physical card index to pin
RERANK_BATCH_SIZE=32

# --- Ingestion safety (Python API) ---
# INGEST_ROOT confines POST /v1/ingest sources to a directory tree. It is unset
# by default and /v1/ingest is DISABLED (503) until you set it — without a root,
# `source` is an arbitrary server-side path read whose text is retrievable back
# through /v1/retrieve. Set it to a directory the API process can read (and, in
# Docker, one deploy/docker-compose.python.yml actually mounts into the api
# container). `/` is refused at startup: it confines nothing.
# Required (non-empty) at startup when REQUIRE_DURABLE_BACKENDS=true.
#INGEST_ROOT=/srv/corpus
MAX_DOCUMENT_BYTES=50000000    # per-document size cap (DoS guard); 0 disables

# --- DOI metadata enrichment (Python API) ---
# Resolves each ingested document's DOI against Crossref (DataCite as fallback)
# and fills MISSING bibliographic fields — title, authors, journal, year,
# publisher, publication_type, url — so uploaded PDFs stop being cited as bare
# filenames. Precedence is always "existing explicit metadata wins, enrichment
# only fills gaps": a title the loader or corpus already supplied is never
# overwritten. Enrichment is best-effort — a 404, timeout, or rate-limit logs
# and the ingest continues with the metadata it already had.
#
# OFF by default: it is the only part of ingest that reaches the public
# internet, so offline/air-gapped deployments are unaffected unless you opt in.
DOI_ENRICHMENT_ENABLED=false
#
# --- Chunk-level boilerplate (scholarly PDFs) ---
# Licence footers, "© The Author(s)" lines, acknowledgements/funding/competing-
# interests blocks and reference lists become chunks that match every query
# weakly and dominate the top-k when nothing scores strongly. Detection is ON by
# default and purely additive: non-body chunks get metadata.section and
# metadata.is_boilerplate, nothing is removed.
BOILERPLATE_DETECTION_ENABLED=true
# Also EXCLUDE them from the index (and skip their embed cost). Off by default —
# a false positive is permanent for that ingest. Recommended ON for a corpus of
# open-access PDFs. Drops are counted and logged per source, never silent, and a
# document that is entirely boilerplate is never emptied.
BOILERPLATE_DROP=false
# Threshold overrides (see BoilerplateConfig for every key and its calibration).
#BOILERPLATE_CONFIG_JSON={"reference_density":15,"boilerplate_sections":["references"]}
# Contact address for Crossref's polite pool. Strongly recommended when enabled.
#DOI_ENRICHMENT_MAILTO=ops@example.org
# On-disk resolution cache (one JSON per DOI, negatives included) so re-ingests
# and repeated DOIs never re-hit the API. Empty = in-process memory only.
#DOI_ENRICHMENT_CACHE_DIR=/rag/data/doi-cache
#DOI_ENRICHMENT_TIMEOUT=10.0
#DOI_ENRICHMENT_CONCURRENCY=4      # politeness contract: max lookups in flight
#DOI_ENRICHMENT_DATACITE_FALLBACK=true
#DOI_ENRICHMENT_USER_AGENT=        # empty builds one from version + mailto

# --- Identity: end-user bearer credentials (Python API) ---
# OFF by default. `none` means the Authorization header is not an authentication
# input at all, so an existing deployment is byte-for-byte unchanged. Turning it
# on adds a second way in: `Authorization: Bearer <credential>` resolves to the
# tenant "{issuer}:{subject}" with the explicit `researcher` role — never
# DEFAULT_ROLE, which is `admin` on the demo box. Presenting an API key AND an
# Authorization header is a 400; an unreachable key server is a 503, never a 401
# and never an allow.
IDENTITY_PROVIDER=none         # none | bvbrc | oidc
# The identity cache TTL is also the revocation lag (BV-BRC tokens cannot be
# revoked before expiry at all, so this stays small). Startup refuses > 300.
#IDENTITY_CACHE_TTL_SECONDS=300
#IDENTITY_KEY_CACHE_TTL_SECONDS=86400
#IDENTITY_HTTP_TIMEOUT_SECONDS=5
#IDENTITY_CLOCK_SKEW_SECONDS=300    # ID-token exp/nbf/iat tolerance; capped at 300
#
# bvbrc: HARD PIN of the SigningSubject URLs whose keys may verify a token.
# BV-BRC's own validateToken.js fetches the key from whatever URL the token
# embeds (its allowlist guard builds an Error it never throws), so without this
# pin anyone who can serve a URL can forge any username. Default is the canonical
# set from P3AuthConstants.pm; narrow it, never widen it blindly.
#IDENTITY_ISSUER_ALLOWLIST=https://user.patricbrc.org/public_key,https://user.bv-brc.org/public_key,https://user.alpha.patricbrc.org/public_key,https://user.beta.patricbrc.org/public_key
#
# oidc: CLIENT_IDS pins `aud`. Without it, an ID token minted for ANY other
# application on the same IdP would authenticate here — so the server refuses to
# boot when it is empty. ALLOWED_ISSUERS overrides the accepted `iss` spellings;
# left empty it is [ISSUER], except for Google, which mints both
# `accounts.google.com` and `https://accounts.google.com`.
#IDENTITY_OIDC_ISSUER=https://accounts.google.com
#IDENTITY_OIDC_CLIENT_IDS=<id>.apps.googleusercontent.com
#IDENTITY_OIDC_ISSUER_LABEL=google
#IDENTITY_OIDC_ALLOWED_ISSUERS=

# --- Retrieval (Python API — honored by ragstack.config.Settings) ---
TOP_K=5
RETRIEVAL_CANDIDATE_MULTIPLIER=2   # per-leg fetch depth = TOP_K * this, before RRF fuse
RRF_K=60                           # Reciprocal Rank Fusion constant
MULTIQUERY_N=3                     # paraphrases per multi-query rewrite (each = 1 extra retrieval)
GRAPH_CONTEXT_SCORE=0.5            # RRF score for graph-triple pseudo-chunks
GRAPH_CONTEXT_DEPTH=1              # graph neighbourhood hop depth
# Per-document diversity: at most N chunks from any one document in the final
# top_k. 0 = off (default, unchanged behaviour). Without it one paper can supply
# the whole answer — on the demo library 3 of the top 5 chunks came from a single
# document. Overflow is demoted, not discarded, so top_k is still filled when
# there is nothing else to promote. 2-3 is a good setting for a paper library.
RETRIEVAL_MAX_PER_DOC=0
# Query-time boilerplate demotion: sort licence footers / reference lists /
# acknowledgement blocks to the back of the candidate pool before the top_k cut.
# Off by default. Unlike BOILERPLATE_DROP this needs NO re-ingest, so it is the
# switch for a collection that was already built without the ingest-time flag.
RETRIEVAL_DEMOTE_BOILERPLATE=false
RERANK_ENABLED=false
RERANK_CANDIDATES=50
TEXT_BACKEND=elasticsearch         # memory | elasticsearch (the real BM25 backend switch)

# Reserved — advertised historically but NOT yet honored by the Python API:
#   DENSE_WEIGHT / SPARSE_WEIGHT   (RRF fusion is currently unweighted — no effect)
#   MIN_RELEVANCE_THRESHOLD        (no score-floor filtering is applied yet)
#   BM25_ENGINE                    (superseded by TEXT_BACKEND above)
# Wiring weighted fusion + a relevance floor is tracked in the config-hardening issue.
