Bootstrap: docker
From: python:3.12-slim-bookworm

# RAGStack SERVER image (PR-F, ADR-0010 migration step 6) — the Python API
# (`uvicorn ragstack.api.main:app`) as one labelled, receipted SIF, so a tenant
# upgrade swaps an image instead of a host conda env + worktree.
#
# Sibling of apptainer/ragstack-tools.def and built by the same script with the
# same identity mechanism — keep the two in step:
#
#   apptainer/build-image.sh --kind server [--out DIR] [--store DIR]... [--dry-run] [--sandbox]
#
#   --build-arg VERSION=v1.6.6            # vX on a release tag, vX+<shortsha> past one
#   --build-arg COMMIT=<full sha>         # the commit whose python/ + cwl/ this is
#   --build-arg BUILD=1                   # N-th build of this version
#   --build-arg BUILD_DATE=2026-10-09T03:00:00Z
#   --build-arg SRC=<tmp>/python          # python/ staged FROM THE COMMIT (git archive HEAD)
#   --build-arg CWL=<tmp>/cwl             # cwl/ staged from the same archive
#
# The same four values land in %labels (org.ragstack.version / commit / build /
# build-date), /opt/ragstack/RELEASE and ragstack/_release.py; the script
# verifies labels + RELEASE after the build and writes
# ragstack-server-<version>-b<N>.sif.receipt.json. No %arguments defaults: a
# build without the values fails instead of minting an unlabelled image.
#
# DIFFERENCES FROM THE TOOLS IMAGE
#   * org.ragstack.role server (tools: worker).
#   * python/ AND cwl/ are staged to /opt/ragstack/{python,cwl}, so
#     cwl/tool-image.receipt.json (the boot image check) ships, and the CWL
#     defaults resolve in-image: GRAPH_EXTRACT_CWL / COLLECTION_RESTORE_CWL
#     default to Path(ragstack/…).parents[2] / "cwl" == /opt/ragstack/cwl.
#   * %environment sets PYTHONPATH=/opt/ragstack/python: `ragstack` imports from
#     the STAGED tree, not site-packages (both carry the same _release.py; the
#     site-packages install is what supplies the dependencies). The
#     build-time version assertion therefore runs twice — once against the
#     installed package, once under PYTHONPATH.
#   * %runscript starts the API: `apptainer run <sif> --host H --port P [uvicorn args]`.
#     umask 0002 (group-writable files under the tenant's DataDir, as the host
#     launcher does), cwd /opt/ragstack, stdout+stderr APPENDED to
#     $RAGSTACK_API_LOG when it is set (the ctl points it at the tenant's
#     <DataDir>/logs/api-<t>.log), inherited otherwise.
#
# The image root is read-only at runtime: every path-valued setting (sqlite
# stores, collections file, caches) must be ABSOLUTE and under a bound
# directory — several default to relative `ragstack_*.db` names, which would
# resolve against /opt/ragstack and fail. The ctl binds identity paths
# (host path == container path) and runs `--no-home --cleanenv` with the
# environment passed as APPTAINERENV_* (PR-F §1.2).
#
# CPU-ONLY, MODELS NOT BAKED IN — as the tools image: same extras, no torch;
# the HF tokenizer comes from a bind-mounted HF_HOME (default /rag/cache).
#
# Smoke test:
#   apptainer exec --cleanenv <sif> python -c "import ragstack, ragstack.version as v; print(ragstack.__file__, v.git_sha())"
#   apptainer exec <sif> cat /opt/ragstack/RELEASE
# See docs/runbooks/server-image.md.

%files
    {{ SRC }} /opt/ragstack/python
    {{ CWL }} /opt/ragstack/cwl

%post
    set -eu
    export PIP_NO_CACHE_DIR=1
    export PIP_DISABLE_PIP_VERSION_CHECK=1

    # Identity first, before the install, so the generated module is part of
    # what pip copies into site-packages AND stays in the staged tree that
    # PYTHONPATH points at. Same four values, three places.
    mkdir -p /opt/ragstack
    cat > /opt/ragstack/RELEASE <<'EOF'
version={{ VERSION }}
commit={{ COMMIT }}
build={{ BUILD }}
build_date={{ BUILD_DATE }}
EOF
    cat > /opt/ragstack/python/ragstack/_release.py <<'EOF'
# Generated by the server-image build (apptainer/ragstack-server.def) — never committed.
# Read by ragstack.version (package_version / git_tag / git_sha) when there is no git checkout.
VERSION = "{{ VERSION }}"
COMMIT = "{{ COMMIT }}"
BUILD = "{{ BUILD }}"
BUILD_DATE = "{{ BUILD_DATE }}"
EOF
    # Wheel metadata must agree with __version__'s public part (see the tools def).
    PUBLIC="{{ VERSION }}"; PUBLIC="${PUBLIC#v}"; PUBLIC="${PUBLIC%%+*}"
    sed -i -E "s/^version = \"[^\"]*\"/version = \"$PUBLIC\"/" /opt/ragstack/python/pyproject.toml
    grep -q "^version = \"$PUBLIC\"" /opt/ragstack/python/pyproject.toml

    python -m pip install --upgrade pip

    # The SAME extras as the tools image (ragstack-tools.def explains each one;
    # version bounds live in python/pyproject.toml only). fastapi and
    # uvicorn[standard] are base dependencies of ragstack. torch is absent.
    python -m pip install "/opt/ragstack/python[vector,pdf,text,tokenization,graph,postgres]"
    python -m pip install sentencepiece protobuf

    # Bytecode for the staged tree now: at runtime the image root is read-only,
    # so without this every boot recompiles every module in memory.
    python -m compileall -q /opt/ragstack/python/ragstack
    chmod -R a+rX /opt/ragstack

    python -c "import ragstack, fastapi, uvicorn, fitz, qdrant_client, elasticsearch, transformers, neo4j, asyncpg; print('build import ok')"

    # Assertion 1 of 2 — the INSTALLED package (site-packages), as in the tools
    # image: __version__ through the generated _release.py, wheel metadata agrees.
    cd / && python - <<'EOF'
from importlib.metadata import version
import ragstack
from ragstack.version import pep440
expected = pep440("{{ VERSION }}")
assert "/site-packages/" in ragstack.__file__, ragstack.__file__
assert ragstack.__version__ == expected, (ragstack.__version__, expected)
assert version("ragstack") == expected.split("+")[0], (version("ragstack"), expected)
print("site-packages: ragstack.__version__ ==", ragstack.__version__, "| wheel metadata", version("ragstack"))
EOF

    # Assertion 2 of 2 — the STAGED tree, which is what %environment's
    # PYTHONPATH makes the API import. Same version; CWL defaults under
    # /opt/ragstack/cwl; and (for a tree that has the RELEASE fallback, PR-F F1)
    # git_tag/git_sha answer from _release.py with no git and no env.
    cd / && env -u RAGSTACK_GIT_TAG -u RAGSTACK_GIT_SHA PYTHONPATH=/opt/ragstack/python python - <<'EOF'
import ragstack
import ragstack.version as v
from pathlib import Path
expected = v.pep440("{{ VERSION }}")
assert ragstack.__file__.startswith("/opt/ragstack/python/ragstack/"), ragstack.__file__
assert ragstack.__version__ == expected, (ragstack.__version__, expected)
for mod in ("graph_extract", "restore"):
    try:
        m = __import__(f"ragstack.{mod}", fromlist=["DEFAULT_CWL"])
    except ImportError:
        continue
    cwl = getattr(m, "DEFAULT_CWL", None)
    if cwl is not None:
        assert Path(cwl).parent == Path("/opt/ragstack/cwl") and Path(cwl).is_file(), (mod, cwl)
if hasattr(v, "_release_attr"):
    assert v.git_tag() == "{{ VERSION }}", v.git_tag()
    assert v.git_sha() == "{{ COMMIT }}", v.git_sha()
    print("staged tree: git_tag", v.git_tag(), "| git_sha", v.git_sha())
else:
    print("staged tree: WARNING this commit predates the _release.py git_tag/git_sha "
          "fallback (PR-F F1); /v1/version needs RAGSTACK_GIT_TAG/SHA in the env")
print("staged tree: ragstack.__version__ ==", ragstack.__version__, "from", ragstack.__file__)
EOF

%environment
    export PYTHONPATH=/opt/ragstack/python
    # Models (the HF tokenizer) are read from a bind-mounted HF_HOME at runtime.
    export HF_HOME=/rag/cache
    export HF_HUB_DISABLE_TELEMETRY=1
    export PYTHONUNBUFFERED=1

%runscript
    umask 0002
    cd /opt/ragstack
    if [ -n "${RAGSTACK_API_LOG:-}" ]; then
        exec python -m uvicorn ragstack.api.main:app "$@" >>"$RAGSTACK_API_LOG" 2>&1
    fi
    exec python -m uvicorn ragstack.api.main:app "$@"

%labels
    org.ragstack.role server
    org.ragstack.gpu false
    org.ragstack.version {{ VERSION }}
    org.ragstack.commit {{ COMMIT }}
    org.ragstack.build {{ BUILD }}
    org.ragstack.build-date {{ BUILD_DATE }}

%help
    RAGStack server image: the Python API. `apptainer run <sif> --host H --port P`
    starts uvicorn on ragstack.api.main:app from /opt/ragstack/python (stdout and
    stderr appended to $RAGSTACK_API_LOG when set). Every path-valued setting must
    be absolute and bound; bind HF_HOME (default /rag/cache) for the tokenizer.
    Identity: `apptainer inspect --labels` (org.ragstack.role server, version,
    commit, build, build-date), /opt/ragstack/RELEASE and the receipt beside the
    image. See docs/runbooks/server-image.md.
