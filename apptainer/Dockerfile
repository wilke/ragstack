# RAGStack CPU-only tools image (#135; "tools", not "worker", per ADR-0010) —
# Docker/OCI parity build.
#
# Parallel to apptainer/ragstack-tools.def: same package + same CPU-only extras,
# so a site with Docker/Podman can build the identical image. On the coconut dev
# host the .def / SIF is the build GoWe + cwltool use; this Dockerfile is for
# portability / other hosts / CI registries.
#
# IDENTITY (ADR-0010): the same four values the SIF build stamps into its
# labels are passed as build args and land in OCI labels, /opt/ragstack/RELEASE
# and the installed ragstack/_release.py. Derive them the same way:
#   eval "$(PYTHONPATH=python python -m ragstack.version --shell)"   # refuses a dirty tree
#   docker build -f apptainer/Dockerfile \
#       --build-arg VERSION="$VERSION" --build-arg COMMIT="$COMMIT" \
#       --build-arg BUILD=1 --build-arg BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
#       -t "ragstack-tools:$VERSION-b1" .
# There are no defaults: a build without them fails at the version self-check.
#
# CPU-ONLY BY DESIGN: every CWL step (ingest_shard / embed_shard / load_embeddings
# / pdf_extract) calls the embedding fleet over HTTP and never runs a model
# locally, so torch/CUDA are deliberately omitted. Deps = the ragstack package +
# its [vector,pdf,text,tokenization] extras (qdrant-client, pymupdf, elasticsearch,
# transformers-for-tokenizer). Versions are pinned by python/pyproject.toml.
#
# MODELS ARE NOT BAKED IN: the HF tokenizer is read at runtime from a bind-mounted
# HF_HOME (default /rag/cache). Mount it when you run:
#   docker run --rm -v /rag/cache:/rag/cache ragstack-tools:<version>-b<N> \
#       python /opt/ragstack/scripts/pdf_extract.py ...
#
# Build from the repo root, so the python/ build context is in scope (above).
#
# Convert to a SIF for apptainer hosts (optional, needs docker running):
#   apptainer build ragstack-tools-<version>-b<N>.sif docker-daemon://ragstack-tools:<version>-b<N>
# A SIF made this way carries the OCI labels; the receipt (sha256) must still be
# computed and stamped with python/scripts/stamp_tool_image.py.
FROM python:3.12-slim-bookworm

ARG VERSION
ARG COMMIT
ARG BUILD
ARG BUILD_DATE

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/rag/cache \
    HF_HUB_DISABLE_TELEMETRY=1

LABEL org.ragstack.role="worker" \
      org.ragstack.gpu="false" \
      org.ragstack.issue="135" \
      org.ragstack.version="${VERSION}" \
      org.ragstack.commit="${COMMIT}" \
      org.ragstack.build="${BUILD}" \
      org.ragstack.build-date="${BUILD_DATE}"

# The build context is the repo root; copy the package tree in.
COPY python /opt/ragstack/python

# Identity before the install, so the generated module is what pip copies in.
RUN printf 'version=%s\ncommit=%s\nbuild=%s\nbuild_date=%s\n' \
        "${VERSION}" "${COMMIT}" "${BUILD}" "${BUILD_DATE}" > /opt/ragstack/RELEASE \
    && printf '# Generated by the tools-image build — never committed.\nVERSION = "%s"\nCOMMIT = "%s"\nBUILD = "%s"\nBUILD_DATE = "%s"\n' \
        "${VERSION}" "${COMMIT}" "${BUILD}" "${BUILD_DATE}" > /opt/ragstack/python/ragstack/_release.py

# The Elasticsearch client is held to the 8.x line by python/pyproject.toml's
# `text` extra (`elasticsearch[async]>=8.13,<9`): a 9.x client's
# `compatible-with=9` header is rejected by an ES 8 server (the deployed cluster
# / prod ragstack env runs 8.x) with a 400 media_type_header_exception. The bound
# lives in pyproject only, on purpose — a second copy here would silently
# disagree with the API env the day the clusters move to ES 9.
RUN python -m pip install --upgrade pip \
    && python -m pip install "/opt/ragstack/python[vector,pdf,text,tokenization]" \
    && python -m pip install sentencepiece protobuf \
    && cp -r /opt/ragstack/python/scripts /opt/ragstack/scripts \
    && chmod -R a+rX /opt/ragstack/scripts \
    && python -c "import ragstack, fitz, qdrant_client, elasticsearch, transformers; print('build import ok')" \
    && cd / && python -c "import ragstack; from ragstack.version import pep440; assert ragstack.__version__ == pep440('${VERSION}'), ragstack.__version__; print('ragstack.__version__ ==', ragstack.__version__)"

WORKDIR /opt/ragstack
# No default CMD: the CWL steps invoke an explicit script path, e.g.
#   python /opt/ragstack/scripts/pdf_extract.py ...
