# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env

# IDE
.idea/
.vscode/
*.iml

# Testing / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Go
go/bin/
go/vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Docker
*.tar

# Apptainer
apptainer/data/
apptainer/images/
*.sif

# Stray runtime artifacts (e.g. redis dumps when run from repo root, or pid files
# left behind by scratch server/process launches)
*.rdb
*.pid

# OS
.DS_Store
Thumbs.db

# local demo scratch (SciFact data, backfill, ingest jsonl)
.localdata/

# Apptainer/Singularity worker images — large build artifacts, not source.
# Build with: apptainer build --sandbox /rag/tmp/ragstack-worker.sbx apptainer/ragstack-worker.def
#          && apptainer build apptainer/images/ragstack-worker.sif /rag/tmp/ragstack-worker.sbx
apptainer/images/*.sif

# Local sqlite state written by the sqlite job/collection-store backends (ADR-0002).
# The registry is per-deployment state, never source.
*.sqlite
*.sqlite3
ragstack_collections.db
ragstack_jobs.db
ragstack_users.db

# Rendered docs site — build output, not source.
# CI publishes from `python docs/build_docs.py --site _site`; run the same command
# without --site to render into docs/ locally. Committing the output let it drift
# three days behind the markdown, and the stale copy still carried a `pkill -f`
# cleanup step that had already been removed from the source (#402).
docs/*.html

# Rendered docs site — build output, not source.
# CI publishes from `python docs/build_docs.py --site _site`. Run the same command
# without --site to render into docs/ locally. Committing the output let it drift
# three days behind the markdown, and the stale copy still carried the `pkill -f`
# cleanup step that had already been removed from the source (#402, #460).
docs/*.html
