# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env

# IDE
.idea/
.vscode/
*.iml

# Testing / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Go
go/bin/
go/vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Docker
*.tar

# Apptainer
apptainer/data/
apptainer/images/
*.sif

# Stray runtime artifacts (e.g. redis dumps when run from repo root, or pid files
# left behind by scratch server/process launches)
*.rdb
*.pid

# OS
.DS_Store
Thumbs.db

# local demo scratch (SciFact data, backfill, ingest jsonl)
.localdata/

# Apptainer/Singularity tools images — large build artifacts, not source.
# Build with: apptainer/build-tools-image.sh  (ADR-0010; names the file
# ragstack-tools-<version>-b<N>.sif and writes <name>.receipt.json beside it)
apptainer/images/*.sif
apptainer/images/*.receipt.json

# Written by the tools-image build into the installed package so
# ragstack.__version__ resolves without git (ragstack/version.py step 2).
# Never committed: in a checkout the version is derived from git.
python/ragstack/_release.py

# Local sqlite state written by the sqlite job/collection-store backends (ADR-0002).
# The registry is per-deployment state, never source.
*.sqlite
*.sqlite3
ragstack_collections.db
ragstack_jobs.db
ragstack_users.db

# Rendered docs site — build output, not source.
# CI publishes from `python docs/build_docs.py --site _site`; run the same command
# without --site to render into docs/ locally. Committing the output let it drift
# three days behind the markdown, and the stale copy still carried a `pkill -f`
# cleanup step that had already been removed from the source (#402).
docs/*.html

# Rendered docs site — build output, not source.
# CI publishes from `python docs/build_docs.py --site _site`. Run the same command
# without --site to render into docs/ locally. Committing the output let it drift
# three days behind the markdown, and the stale copy still carried the `pkill -f`
# cleanup step that had already been removed from the source (#402, #460).
docs/*.html

# Stage-0 judge run logs and pid files — per-run scratch, not source.
docs/plans/results/stage0/run/
!go/internal/ctl/render/testdata/golden/*.sqlite

# ragstack-ctl job store (tests must use a temp dir; the daemon writes under /rag/data/ctl)
jobs.db
jobs.db-shm
jobs.db-wal
docs/adr/*.html
