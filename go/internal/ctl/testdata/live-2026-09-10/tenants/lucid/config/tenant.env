API_KEYS='["<REDACTED:k1>","<REDACTED:k2>","<REDACTED:k3>"]'
API_KEY_TENANTS='{"<REDACTED:k1>":"lucid","<REDACTED:k2>":"lucid","<REDACTED:k3>":"svc-lucid-web"}'
API_KEY_ROLES='{"<REDACTED:k1>":"researcher","<REDACTED:k2>":"admin","<REDACTED:k3>":"user"}'
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6343
QDRANT_COLLECTION_EXPLICIT=lucid_sfr_tok256
TEXT_BACKEND=elasticsearch
# Dedicated ES for this tenant (cut over 2026-08-07). The shared :9200 still
# holds an identical, frozen copy of lucid_sfr_tok256 — rollback is this one
# line plus an API restart. NOTE: lucid PRODUCTION (:8010) is still on :9200,
# so the two indices diverge from here; keep ingest frozen or cut both over.
ELASTICSEARCH_URL=http://localhost:24003
ELASTICSEARCH_INDEX=lucid_sfr_tok256
GRAPH_BACKEND=disabled
EMBEDDING_API=openai
EMBEDDING_ENDPOINTS='["http://localhost:9001","http://localhost:9002","http://localhost:9003","http://localhost:9004"]'
EMBEDDING_MODEL=Salesforce/SFR-Embedding-Mistral
EMBEDDING_MODEL_DIM=4096
COLLECTIONS_FILE=/rag/data/tenants/lucid/config/collections.json
COLLECTION_MANIFEST_DIR=/rag/data/tenants/lucid/manifests
COLLECTION_STORE_BACKEND=sqlite
COLLECTION_STORE_PATH=/rag/data/tenants/lucid/state/collections.db
USER_STORE_BACKEND=sqlite
USER_STORE_PATH=/rag/data/tenants/lucid/state/acl.db
INGEST_ROOT=/rag/data/tenants/lucid/ingest
DEFAULT_ROLE=user
# Bearer identities (added 2026-08-06). Without this the Authorization header
# is not an authentication input at all and a token request 401s.
IDENTITY_PROVIDER=bvbrc
# Break-glass admin allowlist: checked FIRST, no store read, so it works on an
# empty users table and survives a store outage. Admin BYPASSES ownership
# (ADR-0003 decision 5) — which is why these subjects need no owner row and
# the corpus stays owned by 'lucid'.
# clark.cucinell added 2026-08-10 (requested by awilke): no user row exists for
# him yet, so PATCH /v1/admin/users/{subject}/role would 404 — the allowlist is
# the only grant that works before a first sign-in.
ADMIN_SUBJECTS=bvbrc:admin1@example.org,bvbrc:admin2@example.org
ACL_BACKFILL_OWNER=lucid
REQUIRE_DURABLE_BACKENDS=true

RERANK_ENABLED=true
CROSSENCODER_SIDECAR_URL=http://localhost:50052
