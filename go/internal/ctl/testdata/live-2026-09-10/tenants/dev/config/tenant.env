# ==========================================================================
# tenant.env — tenant 'dev' (generated by apptainer/new-tenant.sh)
#
# Load with:   set -a; . /rag/data/tenants/dev/config/tenant.env; set +a
# Never pipe through xargs — it strips the quotes around JSON values.
# JSON values MUST stay single-quoted (this file is shell-sourced).
# Re-running new-tenant.sh KEEPS an edited copy of this file (use --force
# to overwrite); it never re-generates the API keys or the DB password.
# ==========================================================================

# --- identity / authz -----------------------------------------------------
API_KEYS='["<REDACTED:k1>","<REDACTED:k2>"]'
API_KEY_TENANTS='{"<REDACTED:k1>":"dev","<REDACTED:k2>":"dev"}'
API_KEY_ROLES='{"<REDACTED:k1>":"user","<REDACTED:k2>":"admin"}'
DEFAULT_ROLE=user
IDENTITY_PROVIDER=bvbrc
# Break-glass admin allowlist: checked FIRST, no store read, so it works on
# an empty users table and survives a store outage. An env edit + restart is
# the only way to change it.
# Comma-separated (a JSON array also parses). Each entry MUST contain a ':' —
# a colon-free entry would name an API-key tenant and startup refuses it.
# clark.cucinell + olson added 2026-08-11 (requested by awilke): neither has a
# store role, and admin BYPASSES ownership, so they read and write every
# collection in this deployment.
ADMIN_SUBJECTS=bvbrc:admin1@example.org,bvbrc:admin2@example.org
# To accept bearer identities instead, pick one and fill in the pins:
# IDENTITY_PROVIDER=oidc
# IDENTITY_OIDC_ISSUER=https://accounts.example.com
# IDENTITY_OIDC_CLIENT_IDS='["<client-id>"]'
# IDENTITY_PROVIDER=bvbrc    # issuer allowlist is pinned in config.py
MAX_COLLECTIONS=100
USER_STORE_BACKEND=sqlite
USER_STORE_PATH=/rag/data/tenants/dev/state/ragstack_users.db
ACL_BACKFILL_OWNER=legacy:admin

# --- dedicated stores (ADR-0005: data at rest defines the tenant) ---------
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:24041
TEXT_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://localhost:24043
# GRAPH_BACKEND=disabled   # superseded below # window-2026-08-25
JOB_STORE_BACKEND=sqlite
JOB_STORE_PATH=/rag/data/tenants/dev/state/ragstack_jobs.db
COLLECTION_STORE_BACKEND=sqlite
COLLECTION_STORE_PATH=/rag/data/tenants/dev/state/ragstack_collections.db
COLLECTION_MANIFEST_DIR=/rag/data/tenants/dev/manifests
# COLLECTIONS_FILE=/rag/data/tenants/dev/config/collections.json   # optional one-time registry seed

# --- embedding / rerank (shared stateless compute, per ADR-0005) ----------
EMBEDDING_API=openai
EMBEDDING_ENDPOINTS='["http://localhost:9001","http://localhost:9002"]'
EMBEDDING_MODEL=Salesforce/SFR-Embedding-Mistral
EMBEDDING_MODEL_DIM=4096
EMBEDDING_SIDECAR_URL=http://localhost:50053
CROSSENCODER_SIDECAR_URL=http://localhost:50052
# Build the cross-encoder reranker (sidecar above) and rerank by default; the
# per-request `rerank` field can still force it off.
RERANK_ENABLED=true

# --- LLM (answer generation) -----------------------------------------------
# Llama-4-Scout on mango (:8003), same generator as the unified tenant (see
# /rag/config/unified.env for why Scout and not the Qwen reasoning model).
LLM_ENDPOINT=http://mango.cels.anl.gov:8003
LLM_MODEL=RedHatAI/Llama-4-Scout-17B-16E-Instruct-FP8-dynamic
# SSRF gate for runtime model registration — mirror unified so mango-hosted
# models can be registered here too.
MODEL_URL_ALLOWLIST=http://localhost,http://127.0.0.1,http://mango.cels.anl.gov

# --- safety ----------------------------------------------------------------
REQUIRE_DURABLE_BACKENDS=true
INGEST_ROOT=/rag/data/tenants/dev/ingest
MAX_DOCUMENT_BYTES=50000000

# --- API -------------------------------------------------------------------
# PORT is informational only — the API's Settings does not read it; uvicorn
# needs --port 24040 explicitly (see the start command below/in the plan).
PORT=24040
LOG_LEVEL=info

# ---- live-validation window block # window-2026-08-25 ----
INGEST_BACKEND=gowe                                    # window-2026-08-25
GOWE_URL=http://localhost:8091                         # window-2026-08-25
GOWE_WORKFLOW_CWL=/rag/repos/tenants/dev/cwl/pdf-ingest-scatter.cwl   # window-2026-08-25
GOWE_WORKER_GROUP=ragstack                             # window-2026-08-25
WORKSPACE_URL=https://p3.theseed.org/services/Workspace # window-2026-08-25
# GRAPH_BACKEND=neo4j  # BLOCKED: neo4j driver (the `graph` extra) is not installed in /rag/envs/ragstack — API refuses to boot. See report. # window-2026-08-25
GRAPH_BACKEND=disabled                                 # reverted to original pending the graph-extra decision # window-2026-08-25
NEO4J_URI=bolt://localhost:24047                       # window-2026-08-25
NEO4J_USER=neo4j                                       # window-2026-08-25
# policy made explicit (#387 gap); these match code defaults
MAX_COLLECTIONS_PER_OWNER=5                            # window-2026-08-25
MAX_CHUNKS_PER_COLLECTION=50000                        # window-2026-08-25
ALLOW_USER_COLLECTION_CREATE=true                      # window-2026-08-25
# window-only overrides — REVERT in Phase 10
RATE_LIMIT_COLLECTIONS_CREATE_PER_HOUR=30              # window-2026-08-25
RATE_LIMIT_INGEST_PER_HOUR=60                          # window-2026-08-25
# NOTE: ADMIN_SUBJECTS de-admined 2026-08-26 (D1, owner-authorized); original saved in the run dir. REVERT in Phase 10.
