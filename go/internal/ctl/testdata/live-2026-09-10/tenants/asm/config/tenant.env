QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL_DIM=4096
EMBEDDING_MODEL=Salesforce/SFR-Embedding-Mistral
RERANK_ENABLED=true
QDRANT_COLLECTION_EXPLICIT=ragstack_sfr_tok256
TEXT_BACKEND=elasticsearch
EMBEDDING_SIDECAR_URL=http://localhost:9001
EMBEDDING_API=openai
ELASTICSEARCH_INDEX=ragstack_sfr_tok256
CROSSENCODER_SIDECAR_URL=http://localhost:50052
ELASTICSEARCH_URL=http://localhost:9200
COLLECTIONS_FILE=/rag/data/tenants/asm/config/collections.json
COLLECTION_MANIFEST_DIR=/rag/data/tenants/asm/manifests
COLLECTION_STORE_BACKEND=sqlite
COLLECTION_STORE_PATH=/rag/data/tenants/asm/state/collections.db
USER_STORE_BACKEND=sqlite
USER_STORE_PATH=/rag/data/tenants/asm/state/acl.db
INGEST_ROOT=/rag/data/tenants/asm/ingest
DEFAULT_ROLE=user
# Bearer identities (added 2026-08-12). Without this the Authorization header is
# not an authentication input at all: _authenticate() returns before the token is
# ever inspected, so a perfectly valid token still resolves to nobody and the UI
# bounces back to the sign-in screen. This is what asm-next was missing while the
# other tenants had it.
#
# CONSEQUENCE: any valid BV-BRC token now authenticates here as
# bvbrc:<subject> with DEFAULT_ROLE. `open-access` stays world-readable by
# design; `default` no longer is (its public grant was revoked in favour of
# explicit per-account reads).
IDENTITY_PROVIDER=bvbrc
# Break-glass admin allowlist: checked FIRST, no store read, so it works on an
# empty users table and survives a store outage. Admin BYPASSES ownership, so
# these three read and write every collection in this deployment.
ADMIN_SUBJECTS=bvbrc:admin1@example.org,bvbrc:admin2@example.org,bvbrc:admin3@example.org
ACL_BACKFILL_OWNER=asm-ops
REQUIRE_DURABLE_BACKENDS=true
API_KEYS='["<REDACTED:k1>", "<REDACTED:k2>", "<REDACTED:k3>"]'
API_KEY_ROLES='{"<REDACTED:k1>": "admin", "<REDACTED:k3>": "user"}'
API_KEY_TENANTS='{"<REDACTED:k1>": "asm-ops", "<REDACTED:k2>": "asm", "<REDACTED:k3>": "svc-asm-web"}'

# svc-asm-web (added 2026-08-12): the credential for the read-only service
# account created via POST /v1/admin/service-accounts. Role `user`, so it has no
# admin surface; it reaches `default` through an explicit read grant and
# `open-access` through the public grant. Disabling the service-account row
# (POST /v1/admin/service-accounts/svc-asm-web/disable) refuses this key without
# editing this file.

# A spec now claims ragstack_sfr_tok256, so the synthetic 'default' entry no longer
# exists (#275). Without this the omitted-collection path resolves to nothing.
DEFAULT_COLLECTION_ID=asm-tok256

# Answer generation (same endpoint the other deployments use).
LLM_ENDPOINT=http://mango.cels.anl.gov:8003
LLM_MODEL=RedHatAI/Llama-4-Scout-17B-16E-Instruct-FP8-dynamic
MODEL_URL_ALLOWLIST=http://localhost,http://127.0.0.1,http://mango.cels.anl.gov

# Raised from the code default 30s on 2026-08-26: a cold search on the 47.6M-point
# open-access collection (192 segments, dim 4096) timed out for a real user. Measured
# cold read ~14s, warm ~0.02s; the failing request exceeded 30s and we have no latency
# data to say why. INTERIM — revisit once query-latency logging lands.
QDRANT_TIMEOUT=60

# Set 2026-08-26 with v1.4.2, which introduced the knob. The client default is
# 10s — a sixth of QDRANT_TIMEOUT — so the text leg was the binding constraint on
# every hybrid query while the vector leg sat at 60s. Parity, because a hybrid
# query fails at min(the two).
ELASTICSEARCH_TIMEOUT=60
