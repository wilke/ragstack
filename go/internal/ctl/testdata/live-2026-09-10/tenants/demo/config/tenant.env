# ==========================================================================
# tenant.env — tenant 'demo' (generated by apptainer/new-tenant.sh)
#
# Load with:   set -a; . /rag/data/tenants/demo/config/tenant.env; set +a
# Never pipe through xargs — it strips the quotes around JSON values.
# JSON values MUST stay single-quoted (this file is shell-sourced).
# Re-running new-tenant.sh KEEPS an edited copy of this file (use --force
# to overwrite); it never re-generates the API keys or the DB password.
# ==========================================================================

# --- identity / authz -----------------------------------------------------
API_KEYS='["<REDACTED:k1>","<REDACTED:k2>"]'
API_KEY_TENANTS='{"<REDACTED:k1>":"demo-ops","<REDACTED:k2>":"demo"}'
API_KEY_ROLES='{"<REDACTED:k1>":"admin"}'
DEFAULT_ROLE=user
IDENTITY_PROVIDER=bvbrc
# To accept bearer identities instead, pick one and fill in the pins:
# IDENTITY_PROVIDER=oidc
# IDENTITY_OIDC_ISSUER=https://accounts.example.com
# IDENTITY_OIDC_CLIENT_IDS='["<client-id>"]'
# IDENTITY_PROVIDER=bvbrc    # issuer allowlist is pinned in config.py
MAX_COLLECTIONS=100
USER_STORE_BACKEND=sqlite
USER_STORE_PATH=/rag/data/tenants/demo/state/ragstack_users.db
ACL_BACKFILL_OWNER=legacy:admin

# --- dedicated stores (ADR-0005: data at rest defines the tenant) ---------
VECTOR_BACKEND=qdrant

TEXT_BACKEND=elasticsearch

GRAPH_BACKEND=disabled
JOB_STORE_BACKEND=sqlite
JOB_STORE_PATH=/rag/data/tenants/demo/state/ragstack_jobs.db
COLLECTION_STORE_BACKEND=sqlite
COLLECTION_STORE_PATH=/rag/data/tenants/demo/state/ragstack_collections.db
COLLECTION_MANIFEST_DIR=/rag/data/tenants/demo/manifests
# COLLECTIONS_FILE=/rag/data/tenants/demo/config/collections.json   # optional one-time registry seed

# --- embedding / rerank (shared stateless compute, per ADR-0005) ----------
EMBEDDING_API=openai
EMBEDDING_ENDPOINTS=http://localhost:9001,http://localhost:9002,http://localhost:9003,http://localhost:9004
EMBEDDING_MODEL=Salesforce/SFR-Embedding-Mistral
EMBEDDING_MODEL_DIM=4096
EMBEDDING_SIDECAR_URL=http://localhost:50053
CROSSENCODER_SIDECAR_URL=http://localhost:50052

# --- safety ----------------------------------------------------------------
REQUIRE_DURABLE_BACKENDS=true
INGEST_ROOT=/rag/data/tenants/demo/ingest
MAX_DOCUMENT_BYTES=50000000

# --- API -------------------------------------------------------------------
# PORT is informational only — the API's Settings does not read it; uvicorn
# needs --port 24060 explicitly (see the start command below/in the plan).
PORT=24060
LOG_LEVEL=info
ADMIN_SUBJECTS=bvbrc:admin1@example.org
COLLECTIONS_FILE=/rag/config/demo.collections.json
QDRANT_COLLECTION_EXPLICIT=demo_g1_sfr_tok512
ELASTICSEARCH_INDEX=demo_g1_sfr_tok512
LLM_ENDPOINT=http://mango.cels.anl.gov:8003
LLM_MODEL=RedHatAI/Llama-4-Scout-17B-16E-Instruct-FP8-dynamic
RERANK_ENABLED=true
CHUNK_METHOD=fixed_token
CHUNK_SIZE=512
CHUNK_OVERLAP=64
DOI_ENRICHMENT_ENABLED=true
DOI_ENRICHMENT_CACHE_DIR=/rag/cache/doi-cache
DOI_ENRICHMENT_MAILTO=awilke@anl.gov
RETRIEVAL_DEMOTE_BOILERPLATE=true
RETRIEVAL_MAX_PER_DOC=2
HF_HOME=/rag/cache

# --- ADOPTED STORES (ADR-0005 decision 7) ------------------------------------
# demo's data is at rest on the SHARED Qdrant :6333 / Elasticsearch :9200 that
# asm adopted: 6,469,845 points and 10.8 GB of text index for `open-access`,
# plus the small demo_g1_sfr_tok512 default. Standing up the per-tenant
# instances this tenant now has provisioned (:24061/:24063) would mean moving
# all of it to satisfy a naming convention, so the tenant adopts the stores
# where its data already lives and the provisioned dirs stay DORMANT.
#
# demo is therefore still the co-tenant ADR-0005 lists on asm's adopted stores;
# its exit is "repoint to its own stores or retire". Until then bin/up.sh must
# NOT be run — it would start empty instances on :24061/:24063 that nothing
# reads, while this file keeps pointing at the shared pair.
QDRANT_URL=http://localhost:6333
ELASTICSEARCH_URL=http://localhost:9200

# Raised from the code default 30s on 2026-08-26: a cold search on the 47.6M-point
# open-access collection (192 segments, dim 4096) timed out for a real user. Measured
# cold read ~14s, warm ~0.02s; the failing request exceeded 30s and we have no latency
# data to say why. INTERIM — revisit once query-latency logging lands.
QDRANT_TIMEOUT=60

# Set 2026-08-26 with v1.4.2, which introduced the knob. The client default is
# 10s — a sixth of QDRANT_TIMEOUT — so the text leg was the binding constraint on
# every hybrid query while the vector leg sat at 60s. Parity, because a hybrid
# query fails at min(the two).
ELASTICSEARCH_TIMEOUT=60
