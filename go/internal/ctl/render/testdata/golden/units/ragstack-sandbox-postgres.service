[Unit]
Description=ragstack tenant sandbox — postgres (:24085)
PartOf=ragstack-sandbox.target
ConditionPathIsMountPoint=/rag
ConditionPathIsDirectory=/rag/data/tenants/sandbox/postgres/data
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
UMask=0002
Environment=APPTAINER_CACHEDIR=/rag/data/ctl/apptainer/cache
Environment=APPTAINER_CONFIGDIR=/rag/data/ctl/apptainer/config
EnvironmentFile=/rag/data/tenants/sandbox/config/secrets.env
ExecStart=/usr/bin/apptainer run --no-home --bind /rag/data/tenants/sandbox/postgres/data:/var/lib/postgresql/data --bind /rag/data/tenants/sandbox/postgres/run:/var/run/postgresql --env POSTGRES_USER=sandbox --env POSTGRES_DB=sandbox --env PGDATA=/var/lib/postgresql/data/pgdata /rag/apptainer/images/postgres.sif postgres -c port=24085 -c listen_addresses=127.0.0.1
LimitNOFILE=1048576
KillMode=mixed
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
StandardOutput=append:/rag/data/tenants/sandbox/logs/postgres-sandbox.log
StandardError=append:/rag/data/tenants/sandbox/logs/postgres-sandbox.log
