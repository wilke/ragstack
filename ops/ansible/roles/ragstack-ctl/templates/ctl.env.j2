# {{ ansible_managed }} — ops/ansible/roles/ragstack-ctl/templates/ctl.env.j2
# Public ctl settings (0640 {{ ctl_user }}:{{ ragops_group }}). Secrets live in ctl-secrets.env.
# Grammar: KEY=value, no `export`, no `$`, no trailing comments (plan "envfile grammar").
# Key set is exactly api.EnvKeys() minus api.SecretEnvKeys() minus
# CTL_IDENTITY_KEY_FETCH_FILE (test-only override, never templated here) —
# reconciled against go/internal/ctl/api/env.go by
# go/internal/ctl/api/env_template_test.go. A key that belongs here but not in
# env.go is a setting nobody can configure; one in env.go but not here is a
# setting that silently does nothing.
CTL_LISTEN=127.0.0.1:{{ ctl_port }}
CTL_RAG_ROOT={{ rag_root }}
CTL_STATE_DIR={{ rag_root }}/data/ctl
CTL_CONFIG_DIR={{ rag_root }}/config/ctl
CTL_REGISTRY={{ rag_root }}/data/tenants/registry.json
CTL_ADMIN_SUBJECTS='{{ ctl_admin_subjects }}'
CTL_VIEWER_SUBJECTS='{{ ctl_viewer_subjects }}'
{# Emitted only when narrowed. A rendered `CTL_IDENTITY_ISSUER_ALLOWLIST=''`
   is SET-BUT-BLANK, which the daemon refuses to start on (env.go): an empty
   issuer allowlist authenticates nobody, and "take the default four issuers"
   is said by omitting the variable, never by blanking it. #}
{% if ctl_identity_issuer_allowlist %}
CTL_IDENTITY_ISSUER_ALLOWLIST='{{ ctl_identity_issuer_allowlist }}'
{% endif %}
CTL_LOG_LEVEL={{ ctl_log_level }}
CTL_LOG_FORMAT={{ ctl_log_format }}
CTL_RATE_LIMIT_PER_CREDENTIAL={{ ctl_rate_limit_per_credential }}
CTL_RATE_LIMIT_TARPIT_AT={{ ctl_rate_limit_tarpit_at }}
CTL_RATE_LIMIT_TARPIT_DELAY={{ ctl_rate_limit_tarpit_delay }}
CTL_EXTERNAL_STORE_PORTS={{ ctl_external_store_ports }}

# Not CTL_* — process-environment variables the unit needs alongside the
# CTL_* contract above (Apptainer cache/config dirs for rootless image pulls,
# and the user-manager runtime dir for the systemd --user unit).
APPTAINER_CACHEDIR={{ rag_root }}/data/ctl/apptainer/cache
APPTAINER_CONFIGDIR={{ rag_root }}/data/ctl/apptainer/config
XDG_RUNTIME_DIR=/run/user/{{ ctl_uid }}
