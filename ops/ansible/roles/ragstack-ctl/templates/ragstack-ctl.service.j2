# {{ ansible_managed }} — user unit for the {{ ctl_user }} manager, loaded via
# SYSTEMD_UNIT_PATH={{ rag_root }}/config/ctl/units (root drop-in, coconut-host role).
[Unit]
Description=ragstack-ctl tenant control plane ({{ ctl_version | default('unversioned', true) }})
Documentation=file:{{ rag_root }}/repos/ragstack.git
# NOT ConditionPathIsMountPoint={{ rag_root }}: a failed Condition makes systemd SKIP
# the unit and report the skip as success, so on any host where {{ rag_root }} is a
# plain directory rather than a mount point (a second site, a test box, a
# bind-mount that resolves to the same filesystem) the daemon would silently
# never start while `systemctl --user status` reported nothing wrong. What the
# unit actually needs is its state directory; waiting for the MOUNT is the
# RequiresMountsFor={{ rag_root }} in the user@ drop-in, where a miss delays the
# unit instead of quietly cancelling it.
ConditionPathIsDirectory={{ rag_root }}/data/ctl
After=network-online.target

[Service]
Type=simple
EnvironmentFile={{ rag_root }}/config/ctl/ctl.env
EnvironmentFile=-{{ rag_root }}/config/ctl/ctl-secrets.env
Environment=HOME={{ rag_root }}/data/ctl/home
WorkingDirectory={{ rag_root }}/data/ctl
ExecStart={{ rag_root }}/bin/ragstack-ctl serve
Restart=always
RestartSec=5s
UMask=0002
StandardOutput=append:{{ rag_root }}/data/ctl/ctl.log
StandardError=inherit

[Install]
WantedBy=default.target
