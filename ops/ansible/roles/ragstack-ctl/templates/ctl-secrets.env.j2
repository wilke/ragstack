# {{ ansible_managed }} — ctl secrets (0600 {{ ctl_user }}). Values from ansible-vault; never committed.
# Key set is exactly api.SecretEnvKeys() — reconciled against
# go/internal/ctl/api/env.go by go/internal/ctl/api/env_template_test.go.
# CTL_ADMIN_SUBJECTS lives in ctl.env: a bearer subject is a user name, not a
# credential.
CTL_API_KEYS='{{ ctl_api_keys }}'
CTL_API_KEY_ROLES='{{ ctl_api_key_roles }}'
CTL_API_KEY_NAMES='{{ ctl_api_key_names }}'
# key -> the identity principal it belongs to ("bvbrc:alice@patricbrc.org"),
# which is what lets that identity authorize a mutation by re-presenting the
# key in the body. Its KEYS are the ctl API keys, so it belongs in this file.
CTL_API_KEY_PRINCIPALS='{{ ctl_api_key_principals }}'
