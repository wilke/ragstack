    "codex_fallback": true,
    "codex_cli": "codex",
    "codex_model": "gpt-6-astra",
    "max_calls": 1000,
    "max_cost_usd": 100.0
  },
  "limits": {
    "input_token_cap": 2500000,
    "output_token_cap": 1000000,
    "call_cap": 2500,
    "prior_gateway_usage": [],
    "max_calls": null,
    "notice_overrun": 0.10
  },
  "yield_watch": {"after_jobs": 100, "min_pass": 0.30},
  "prereg": {"file": null, "sha256": null}
