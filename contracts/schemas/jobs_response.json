{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jobs_response.json",
  "title": "JobsResponse",
  "description": "Most-recent ingest jobs with progress counts (admin view).",
  "type": "object",
  "required": ["jobs"],
  "properties": {
    "jobs": {
      "type": "array",
      "items": { "$ref": "#/$defs/JobSummary" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "JobItemCounts": {
      "type": "object",
      "required": ["pending", "completed", "failed"],
      "properties": {
        "pending": { "type": "integer" },
        "completed": { "type": "integer" },
        "failed": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "JobSummary": {
      "type": "object",
      "required": ["job_id", "status", "source", "error", "chunks", "items"],
      "properties": {
        "job_id": { "type": "string" },
        "status": { "type": "string" },
        "source": { "type": "string" },
        "error": { "type": "string" },
        "chunks": { "type": "integer" },
        "items": { "$ref": "#/$defs/JobItemCounts" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Caller-safe notes on a job that completed with a caveat (#847): e.g. `symbol_glossary_degraded: 2 of 40 document(s) (timeout=2) endpoint host:port` when the glossary step's model half degraded for some documents (they carry the rules glossary). Labels, counts and host:port only, never a raw message or a credential. Optional: an implementation that records none may omit it."
        }
      },
      "additionalProperties": false
    }
  }
}
