{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chunks_response.json",
  "title": "ChunksResponse",
  "description": "Chunks fetched by id (context expansion around a retrieved source).",
  "type": "object",
  "required": ["chunks"],
  "properties": {
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id", "chunk_id", "content"],
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "chunk_id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "default": {}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
