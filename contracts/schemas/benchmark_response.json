{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark_response.json",
  "title": "BenchmarkResponse",
  "description": "One-shot throughput estimate over the live embedder + LLM (admin view).",
  "type": "object",
  "required": ["embedding", "llm"],
  "properties": {
    "embedding": { "$ref": "#/$defs/BenchResult" },
    "llm": { "$ref": "#/$defs/BenchResult" }
  },
  "additionalProperties": false,
  "$defs": {
    "BenchResult": {
      "type": "object",
      "required": ["model", "ok", "seconds", "items", "items_per_sec", "tokens_per_sec", "detail"],
      "properties": {
        "model": { "type": "string" },
        "ok": { "type": "boolean" },
        "seconds": { "type": ["number", "null"] },
        "items": { "type": ["integer", "null"] },
        "items_per_sec": { "type": ["number", "null"] },
        "tokens_per_sec": { "type": ["number", "null"] },
        "detail": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
