{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collection_info.json",
  "title": "CollectionInfo",
  "description": "One registry collection the query API can serve.",
  "type": "object",
  "required": ["id", "label", "model", "dim", "default"],
  "properties": {
    "id": { "type": "string" },
    "label": { "type": "string" },
    "model": { "type": "string" },
    "dim": { "type": "integer" },
    "chunk_method": { "type": ["string", "null"] },
    "chunk_size": { "type": ["integer", "null"] },
    "default": { "type": "boolean" },
    "count": {
      "description": "Tenant-scoped chunk count (own + public); null when unavailable.",
      "type": ["integer", "null"]
    },
    "provenance": {
      "description": "Verified build lineage from the collection's manifest; null when no manifest exists.",
      "type": ["object", "null"],
      "properties": {
        "chunk_method": { "type": ["string", "null"] },
        "chunk_size": { "type": ["integer", "null"] },
        "chunk_overlap": { "type": ["integer", "null"] },
        "chunk_params": { "type": "object" },
        "spec_hash": { "type": "string" },
        "corpus": { "type": "string" },
        "chunk_count": { "type": ["integer", "null"] },
        "ingested_at": { "type": "string" },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
