{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config_response.json",
  "title": "ConfigResponse",
  "description": "Allowlisted, non-sensitive operational configuration for the admin dashboard. Secrets (API keys, passwords, DSNs, api_key_tenants/api_key_roles) are never included.",
  "type": "object",
  "required": [
    "vector_backend", "text_backend", "graph_backend", "job_store_backend",
    "require_durable_backends", "qdrant_url", "qdrant_collection",
    "qdrant_collection_explicit", "elasticsearch_url", "elasticsearch_index",
    "neo4j_uri", "embedding_api", "embedding_model", "embedding_model_dim",
    "embedding_endpoints", "embedding_max_concurrency", "chunk_method",
    "chunk_size", "chunk_overlap", "chunk_max_tokens", "chunk_token_counter",
    "top_k", "rerank_enabled", "rerank_candidates", "reranker_model",
    "crossencoder_sidecar_url", "kg_extraction_enabled", "ingest_concurrency",
    "ingest_shard_size", "tenant_max_concurrency", "max_document_bytes",
    "allow_user_collection_create", "log_level"
  ],
  "properties": {
    "vector_backend": { "type": "string" },
    "text_backend": { "type": "string" },
    "graph_backend": { "type": "string" },
    "job_store_backend": { "type": "string" },
    "require_durable_backends": { "type": "boolean" },
    "qdrant_url": { "type": "string" },
    "qdrant_collection": { "type": "string" },
    "qdrant_collection_explicit": { "type": "string" },
    "elasticsearch_url": { "type": "string" },
    "elasticsearch_index": { "type": "string" },
    "neo4j_uri": { "type": "string" },
    "embedding_api": { "type": "string" },
    "embedding_model": { "type": "string" },
    "embedding_model_dim": { "type": "integer" },
    "embedding_endpoints": { "type": "array", "items": { "type": "string" } },
    "embedding_max_concurrency": { "type": "integer" },
    "chunk_method": { "type": "string" },
    "chunk_size": { "type": "integer" },
    "chunk_overlap": { "type": "integer" },
    "chunk_max_tokens": { "type": ["integer", "null"] },
    "chunk_token_counter": { "type": "string" },
    "top_k": { "type": "integer" },
    "rerank_enabled": { "type": "boolean" },
    "rerank_candidates": { "type": "integer" },
    "reranker_model": { "type": "string" },
    "crossencoder_sidecar_url": { "type": "string" },
    "kg_extraction_enabled": { "type": "boolean" },
    "ingest_concurrency": { "type": "integer" },
    "ingest_shard_size": { "type": "integer" },
    "tenant_max_concurrency": { "type": "integer" },
    "max_document_bytes": { "type": "integer" },
    "allow_user_collection_create": { "type": "boolean" },
    "log_level": { "type": "string" }
  },
  "additionalProperties": false
}
